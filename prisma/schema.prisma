datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL") // این خط متغیر محیطی را می‌خواند
}

generator client {
    provider = "prisma-client-js"
}

model OTP {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    phone     String
    codeHash  String
    createdAt DateTime @default(now())
    expiresAt DateTime
}
